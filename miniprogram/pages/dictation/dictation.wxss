/* 语音报默页：田字格是全 App 的签名元素 */
.dz-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.dz-pause {
  font-size: 26rpx;
  color: var(--muted);
}

/* 格子进度条（与首页同款，抽公共样式放 D3） */
.progress-track {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.progress-cell {
  flex: 1;
  height: 36rpx;
  border-radius: 8rpx;
  background: var(--line);
}
.progress-cell.done { background: var(--green-ok); }
.progress-cell.miss { background: var(--red-pen); }
.progress-cell.current { background: var(--lemon); }

/* 田字格：外框实线 + 内部虚线十字 */
.dz-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tianzigge {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  border: 3rpx solid var(--ink);
  border-radius: 8rpx;
  background: #fff;
  margin: 12rpx 0 24rpx;
}
.tz-line {
  position: absolute;
  background: none;
  border: 0;
}
.tz-v {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 2rpx dashed var(--grid-line);
}
.tz-h {
  top: 50%;
  left: 0;
  right: 0;
  height: 0;
  border-top: 2rpx dashed var(--grid-line);
}
.dz-hint { font-size: 22rpx; }

/* 田字格中央序号：报默中不露字，只报第几词 */
.tz-num {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  font-weight: 600;
  color: var(--grid-line);
}

/* 朗读状态灯 */
.dz-status {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.dz-status.is-speaking { color: var(--ink); font-weight: 500; }

/* ready 卡 */
.dz-ready-card { margin-top: 8rpx; }
.start-btn { margin-top: 24rpx; text-align: center; }

/* 断点续默卡 */
.resume-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--grid-line);
  border-radius: var(--radius-btn);
  background: var(--paper);
}
.resume-title { font-size: 26rpx; font-weight: 500; }
.resume-sub { font-size: 22rpx; margin-top: 4rpx; }
.resume-actions { display: flex; align-items: center; gap: 20rpx; }
.resume-btn { padding: 12rpx 36rpx; font-size: 26rpx; }
.resume-discard { font-size: 24rpx; }

/* D2 词表预览 */
.preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin: 20rpx 0;
}
.preview-item {
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.preview-word {
  font-size: 28rpx;
  font-weight: 500;
}
.preview-pinyin {
  font-size: 20rpx;
}

/* 控制条 */
.ctrl-row {
  display: flex;
  gap: 24rpx;
  margin: 8rpx 0 20rpx;
}
.ctrl-btn {
  flex: 1;
}

/* 标对 / 标错 */
.judge-row {
  display: flex;
  gap: 24rpx;
}
.judge-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 500;
}
.judge-wrong {
  background: var(--fill-red);
  color: var(--ink-red);
}
.judge-right {
  background: var(--fill-green);
  color: var(--ink-green);
}

/* done 结果卡 */
.dz-done-card { margin-top: 8rpx; }
.done-title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.done-score { display: flex; align-items: baseline; gap: 20rpx; margin-bottom: 16rpx; }
.done-pct { font-size: 96rpx; font-weight: 700; }
.pct-good { color: var(--green-ok); }
.pct-mid { color: var(--ink-amber); }
.done-sub { font-size: 26rpx; }
.done-sec { font-size: 26rpx; font-weight: 500; margin: 12rpx 0; }
.done-btn { text-align: center; margin-bottom: 8rpx; }
.wrong-item { border-color: var(--red-pen); }

/* 手写判分（M2.2） */
.hw-card { margin-top: 16rpx; }
.hw-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.hw-hint { font-size: 22rpx; }
.hw-mini {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}
.hw-submit {
  margin-top: 16rpx;
  text-align: center;
  font-size: 28rpx;
}
.hw-submit.is-loading { opacity: 0.6; }
.hw-result {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-btn, 16rpx);
}
.hw-ocr { display: block; font-size: 22rpx; }
.hw-verdict { display: block; font-size: 34rpx; font-weight: 700; margin-top: 8rpx; }
.v-ok { color: var(--green-ok); }
.v-bad { color: var(--ink-red); }
.hw-result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  align-items: center;
}
.hw-mini-primary {
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: var(--lemon);
  color: var(--ink);
  font-weight: 600;
}

/* 词解读 */
.ex-card { margin-top: 16rpx; padding: 22rpx 24rpx; }
.ex-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
}
.ex-arrow { font-size: 22rpx; font-weight: 400; }
.ex-body { margin-top: 14rpx; }
.ex-loading { font-size: 24rpx; }
.ex-error { font-size: 24rpx; color: var(--ink-red); }
.ex-meaning { font-size: 27rpx; line-height: 1.7; }
.ex-row { font-size: 24rpx; margin-top: 10rpx; line-height: 1.6; }
