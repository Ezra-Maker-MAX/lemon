.review-btn {
  margin-top: 28rpx;
}

.wb-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 4rpx 4rpx 16rpx;
}
.wb-sub { font-size: 24rpx; }

.wb-item { margin-bottom: 16rpx; }
.wrong-book-cell { display: flex; align-items: baseline; gap: 16rpx; }
.wb-word { font-size: 44rpx; font-weight: 700; color: var(--ink); }
.wb-pinyin { font-size: 26rpx; }

.wb-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
}
.wb-wrong { color: var(--red-pen); font-weight: 600; }
.wb-streak {
  color: var(--ink-green);
  background: var(--fill-green);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  font-size: 22rpx;
}

.wb-gen-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.wb-gen-hint { font-size: 22rpx; }

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--ink);
}
.step-num { font-size: 30rpx; font-weight: 600; color: var(--ink); }
