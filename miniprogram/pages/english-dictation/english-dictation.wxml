<view class="page-body">
  <!-- ===== running ===== -->
  <block wx:if="{{phase === 'running'}}">
    <view class="card en-card">
      <view class="tag tag-mint">{{unitTitle}} · {{index + 1}}/{{words.length}}</view>

      <view class="ed-status {{speaking ? 'is-speaking' : ''}}">
        {{speaking ? "🔊 朗读中…" : "👂 拼写在本子上"}}
      </view>
      <view class="ed-zh">中文提示：{{current.zh}}</view>

      <!-- 揭示拼写：逐字母四线三格大字（照抄到手写板） -->
      <view class="ed-reveal" wx:if="{{revealed}}">
        <view class="en-cell" wx:for="{{revealCells}}" wx:key="index" wx:for-item="c">{{c.ch}}</view>
      </view>
      <view class="four-line ed-line ed-empty" wx:else>
        <text class="ed-q">？</text>
      </view>
    </view>

    <!-- 手写拼写区（M2.2）：四线三格手写 → 提交 OCR 判分 -->
    <view class="card hw-card">
      <view class="hw-toolbar">
        <text class="muted hw-hint">✍️ 在四线格里拼写本词</text>
        <view class="btn-ghost hw-mini" bindtap="onHwClear">🧹 清空</view>
      </view>
      <handwrite id="hw" bg="fourline" />
      <view class="btn-primary hw-submit {{hwLoading ? 'is-loading' : ''}}" bindtap="onHwSubmit">
        {{hwLoading ? "判分中…" : "提交判分"}}
      </view>

      <view class="hw-result" wx:if="{{hwJudge}}">
        <text class="hw-ocr muted">识别：{{hwJudge.ocr}}</text>
        <text class="hw-verdict {{hwJudge.judge === 'ok' ? 'v-ok' : 'v-bad'}}">
          {{hwJudge.judge === 'ok' ? '✓ 拼对了' : '✗ 拼错了'}}
        </text>
        <!-- 判错：逐字母定位哪里错 -->
        <view class="hw-detail" wx:if="{{hwJudge.judge === 'wrong' && hwJudge.detail}}">
          <view class="hw-detail-cells">
            <view class="hd-cell {{c.status}}" wx:for="{{hwJudge.detail}}" wx:key="index" wx:for-item="c">
              <text class="hd-ch">{{c.ch}}</text>
              <text class="hd-sub" wx:if="{{c.status === 'bad'}}">写{{c.got}}</text>
              <text class="hd-sub" wx:elif="{{c.status === 'miss'}}">漏</text>
            </view>
          </view>
          <view class="hd-hint" wx:if="{{hwJudge.hint}}">{{hwJudge.hint}}</view>
        </view>
        <view class="hw-result-actions">
          <view class="btn-ghost hw-mini" bindtap="onHwToggle">改判</view>
          <view class="btn-primary hw-mini-primary" bindtap="onHwNext">下一个词 ›</view>
        </view>
      </view>
    </view>

    <!-- 词典释义（M2.2） -->
    <view class="card ex-card">
      <view class="ex-trigger" bindtap="onExplain">
        <text>📖 这个词什么意思？</text>
        <text class="muted ex-arrow">{{explain ? (explain.level === 1 ? "联网详解 ›" : (explain.loading ? "加载中…" : "收起")) : "点开"}}</text>
      </view>
      <view class="ex-body" wx:if="{{explain}}">
        <view class="muted ex-loading" wx:if="{{explain.loading}}">查询词典中…</view>
        <view class="ex-error" wx:if="{{explain.error}}">{{explain.error}}</view>
        <block wx:if="{{!explain.loading && !explain.error}}">
          <view class="ex-phonetic" wx:if="{{explain.phonetic}}">{{explain.phonetic}}</view>
          <view class="ex-meaning" wx:for="{{explain.meanings}}" wx:key="index">• {{item}}</view>
          <view class="ex-row" wx:if="{{explain.example}}">✏️ {{explain.example}}</view>
        </block>
      </view>
    </view>

    <view class="ctrl-row">
      <view class="btn-ghost ctrl-btn" bindtap="onRepeat">🔁 再听一次</view>
    </view>

    <view class="btn-primary ed-btn" wx:if="{{!revealed}}" bindtap="onReveal">显示拼写（记入错词本）</view>
    <view class="judge-row" wx:else>
      <view class="judge-btn judge-wrong" bindtap="mark" data-ok="0">拼错了</view>
      <view class="judge-btn judge-right" bindtap="mark" data-ok="1">拼对了</view>
    </view>
  </block>

  <!-- ===== done ===== -->
  <block wx:if="{{phase === 'done'}}">
    <view class="card en-card">
      <view class="done-title">本轮完成 🍋</view>
      <view class="done-score">
        <text class="done-pct {{result.correct === result.total ? 'pct-good' : 'pct-mid'}}">{{result.pct}}%</text>
        <text class="muted done-sub">对 {{result.correct}} / 错 {{result.wrongList.length}}</text>
      </view>
      <block wx:if="{{result.wrongList.length}}">
        <view class="done-sec">错词（连对 3 次出池）</view>
        <view class="ed-wrong-list">
          <view class="ed-wrong-item" wx:for="{{result.wrongList}}" wx:key="en">
            <text class="ed-wrong-en">{{item.en}}</text>
            <text class="muted">{{item.zh}}</text>
          </view>
        </view>
        <view class="btn-primary ed-btn" bindtap="onRetryWrong">只练错词（{{result.wrongList.length}}）</view>
      </block>
      <block wx:else>
        <view class="done-sec">全对，perfect！</view>
      </block>
      <view class="ctrl-row">
        <view class="btn-ghost ctrl-btn" bindtap="onBack">回单词列表</view>
      </view>
    </view>
  </block>
</view>
