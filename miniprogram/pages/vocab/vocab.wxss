/* 词库选择页 */
.grade-head {
  background: var(--lemon);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.grade-main {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}
.term-switch {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.term-option {
  padding: 12rpx 44rpx;
  border-radius: var(--radius-btn);
  border: 1rpx solid var(--ink);
  font-size: 26rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.4);
}
.term-option.active {
  background: var(--ink);
  color: var(--lemon);
  font-weight: 500;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 单元网格 2×4 */
.unit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.unit-cell {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  background: var(--paper);
}
.unit-active {
  border-color: var(--ink);
  background: var(--fill-amber);
}
.unit-name {
  font-size: 27rpx;
  font-weight: 500;
}
.unit-count {
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 表类型 */
.list-type-row {
  display: flex;
  gap: 16rpx;
}
.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 1rpx solid var(--line);
  color: var(--ink);
  background: var(--paper);
}
.type-green { background: var(--fill-green); color: var(--ink-green); border-color: transparent; }
.type-amber { background: var(--fill-amber); color: var(--ink-amber); border-color: transparent; }
.type-blue { background: var(--fill-blue); color: var(--ink-blue); border-color: transparent; }
.type-active {
  border: 2rpx solid var(--ink);
  font-weight: 600;
}
.type-hint {
  font-size: 20rpx;
  margin-top: 14rpx;
}

/* 词数 stepper */
.stepper-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.step-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 1rpx solid var(--line);
  text-align: center;
  line-height: 66rpx;
  font-size: 36rpx;
  color: var(--ink);
}
.step-num {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 120rpx;
  text-align: center;
}

.start-btn {
  margin-top: 8rpx;
}
