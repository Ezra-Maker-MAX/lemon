/* 首页：柠檬黄信息头是签名视觉，其余保持作业纸安静 */
.hero {
  background: var(--lemon);
  padding: 48rpx 32rpx 40rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 24rpx;
  color: var(--ink);
  opacity: 0.7;
  margin-top: 8rpx;
}

/* 今日任务卡 */
.task-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 20rpx 0 4rpx;
}
.task-hint { font-size: 22rpx; margin-bottom: 20rpx; }

/* 格子进度条：绿=对 黄=当前 灰=未报 */
.progress-track {
  display: flex;
  gap: 10rpx;
  margin-bottom: 28rpx;
}
.progress-cell {
  flex: 1;
  height: 36rpx;
  border-radius: 8rpx;
  background: var(--line);
}
.progress-cell.done { background: var(--green-ok); }
.progress-cell.current { background: var(--lemon); }

/* 模块卡 2 列 */
.module-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.module-card {
  flex: 1;
  border-radius: var(--radius-card);
  padding: 32rpx;
}
.module-cn {
  background: var(--ink);
}
.module-cn .module-name { color: var(--lemon); }
.module-en {
  background: #fff;
  border: 1rpx solid var(--line);
}
.module-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.module-desc {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.module-cn .module-desc { color: rgba(253, 252, 247, 0.7); }
.module-disabled .module-desc { color: var(--muted); }

.stat-hint { margin-top: 16rpx; font-size: 22rpx; }

/* 统计卡：三格横排 */
.stat-row {
  display: flex;
  margin-top: 20rpx;
}
.stat-block {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
}
.stat-num.stat-red { color: var(--red-pen); }
.stat-label { font-size: 22rpx; margin-top: 4rpx; }

/* 更多练法四宫格 */
.extra-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}
.extra-item {
  width: calc((100% - 60rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 0 20rpx;
  border-radius: var(--radius-btn);
  border: 2rpx solid var(--line);
  background: var(--paper);
}
.extra-item:active { background: #FFF8E1; }
.extra-icon { font-size: 44rpx; }
.extra-name {
  font-size: 22rpx;
  color: var(--ink);
  text-align: center;
}
